[ENABLE]

aobscanmodule(AmeritaMultiplier,nioh.exe,4C 03 CA 48 8B F9) // should be unique
alloc(newmem,$1000,"nioh.exe"+48C82C)
alloc(multiplier,$4)

label(code)
label(return)

multiplier:
db 00 00 00 40

newmem:

code:
  push rdx
  cvtsi2ss xmm15, rdx
  movss xmm14, [multiplier]
  mulss xmm15, xmm14
  cvtss2si rdx, xmm15
  add r9,rdx
  pop rdx
  mov rdi,rcx
  jmp return

AmeritaMultiplier:
  jmp newmem
  nop
return:
registersymbol(AmeritaMultiplier)
registersymbol(multiplier)

[DISABLE]

AmeritaMultiplier:
  db 4C 03 CA 48 8B F9

unregistersymbol(AmeritaMultiplier)
dealloc(newmem)
unregistersymbol(multiplier)
dealloc(multiplier)

