label(code)
label(return)
label(xunhuan)
label(xunhuan2)
label(xunhuan3)
label(xunhuan4)
label(shujuptr)

newmem:
mov [shujuptr+c],r11
mov [shujuptr+14],r10d
cmp byte [shujuptr+8],1
jne code
movzx rax,word [shujuptr]
push rsi
push rdx
push rcx
push rax

mov rsi,[shujuptr+c]
mov rdx,[shujuptr+14]
xor rcx,rcx

test rsi,rsi
je xunhuan2

xunhuan3:
cmp rcx,rdx
jge xunhuan2

xunhuan:
cmp word [rsi+rcx*8+4],ax
je xunhuan4
inc rcx
jmp short xunhuan3

xunhuan4:
mov dx,word [rsi+rcx*8]
mov word [rbx+8],dx

xunhuan2:
pop rax
pop rcx
pop rdx
pop rsi

code:
  lea r9,[rdi+08]
  imul rax,rax,000000B8
  jmp return

shujuptr:
db 02 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
registersymbol(shujuptr)

INJECT:
  jmp newmem
  nop
  nop
  nop
  nop
  nop
  nop
return:
registersymbol(INJECT)

[DISABLE]
INJECT:
db 4C 8D 4F 08 48 69 C0 B8 00 00 00 4C 03 C8

unregistersymbol(INJECT4)
unregistersymbol(INJECT)
